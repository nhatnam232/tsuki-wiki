{
  "name": "tsuki-server-v2",
  "private": true,
  "version": "0.1.0",
  "description": "Self-hosted backend for tsuki-wiki (replaces Supabase) — Node 22 + Express + SQLite WAL",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch index.ts",
    "build": "esbuild index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/server.cjs --external:better-sqlite3",
    "start": "node dist/server.cjs",
    "test": "for f in test/*.test.ts; do npx tsx --test \"$f\" || exit 1; done",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "express": "^4.22.1",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.30",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.25.10",
    "tsx": "^4.20.3",
    "typescript": "~5.8.3"
  }
}
