# ── server-v2 / Phase 0 ─────────────────────────────────────────────
# Copy thành .env rồi điền. KHÔNG commit .env.

# Bắt buộc ở production: >= 32 ký tự. Dev để trống sẽ dùng secret tạm (mất khi restart).
JWT_SECRET=

NODE_ENV=development
PORT=4000

# Đường dẫn file SQLite (default ./data/app.db)
DB_PATH=./data/app.db

# true (mặc định) → cookie có Secure. Dev http://localhost muốn trình duyệt gửi
# cookie thì đặt false. Test không phụ thuộc biến này.
COOKIE_SECURE=true

# Path của refresh cookie: /api/auth (gồm refresh + logout).
# Đặt "/" nếu cần logout revoke được cả khi access token đã hết hạn.
REFRESH_COOKIE_PATH=/api/auth

# Chỉ bật khi chạy sau reverse proxy (nginx/Vercel) để req.ip đúng cho rate limit.
TRUST_PROXY=0

# Rate limit auth (mặc định: 10 req / 15 phút / IP cho login+signup)
AUTH_RATE_MAX=10
AUTH_RATE_WINDOW_MS=900000
AUTH_REFRESH_MAX=60
AUTH_REFRESH_WINDOW_MS=60000

# Cache role (badges) theo ms. 0 = không cache. Không nên > 60000.
ROLE_CACHE_TTL_MS=30000

# CORS whitelist, phân tách bằng dấu phẩy (mặc định rỗng = chỉ same-origin).
CORS_ORIGINS=

# Google OAuth (để trống → /api/auth/google/* trả 503 oauth_not_configured)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=
# Nơi redirect sau khi login Google thành công (mặc định SITE_URL hoặc "/")
OAUTH_SUCCESS_REDIRECT=
SITE_URL=

# Cron secret cho /api/admin/* (Phase 1). Không dùng x-vercel-cron-signature.
CRON_SECRET=

# ── Pterodactyl / deploy ────────────────────────────────────────────
# Loader zero-dep đọc file .env nằm CẠNH server.cjs (hoặc ENV_FILE=<path>).
# Env thật trong process.env luôn thắng .env (không bị override).
# PORT ưu tiên trước SERVER_PORT; Pterodactyl inject SERVER_PORT = allocation.
SERVER_PORT=
# Chạy bằng IP:port qua HTTP (chưa có domain/TLS) → BẮT BUỘC đặt false,
# nếu không browser sẽ không lưu cookie Secure và không đăng nhập được.
# Khi đã có domain + HTTPS thì bỏ dòng này (mặc định true).
COOKIE_SECURE=true

# Discord webhook nhận mật khẩu admin mới (tuỳ chọn, khuyến nghị dùng spoiler)
ADMIN_PASSWORD_WEBHOOK=
# Rate limit rotate-password (mặc định 10/phút/IP)
ADMIN_ROTATE_MAX=10
ADMIN_ROTATE_WINDOW_MS=60000

# ── Proxy / origin gate ─────────────────────────────────────────────
# IP hoặc CIDR của reverse proxy được tin (phẩy phân tách). QUAN TRỌNG:
# - Chỉ những peer trong danh sách này mới được đọc `cf-connecting-ip`.
# - Danh sách RỖNG = fail-closed: mọi request bị 403 `untrusted_proxy`
#   (trừ khi ALLOW_DIRECT=1). Đây là chủ ý — allowlist rỗng KHÔNG có nghĩa
#   là "tin tất cả".
# Production (cloudflared chạy trong container): TRUSTED_PROXIES=127.0.0.1
# Nếu cloudflared chạy ở host khác container, đặt IP public của host đó.
TRUSTED_PROXIES=

# CHỈ dùng cho dev local (bỏ qua requireTrustedProxy). KHÔNG bật ở production.
ALLOW_DIRECT=

# Bind address. Khi TUNNEL_TOKEN có mặt, mặc định là 127.0.0.1 (allocation port
# không bị lộ ra internet). Chỉ set 0.0.0.0 nếu thật sự muốn expose trực tiếp.
HOST=

# Token của Cloudflare Tunnel (Zero Trust → Networks → Tunnels → token).
# Có token ⇒ server tự spawn ./cloudflared và bind loopback.
TUNNEL_TOKEN=

# hCaptcha secret (server-side verification of /api/auth/login|register).
# Để trống = KHÔNG enforce (dev/test). Production PHẢI set, nếu không captcha ở
# UI chỉ là ma sát cho người dùng thật còn bot gọi thẳng API thì không bị gì.
HCAPTCHA_SECRET=
