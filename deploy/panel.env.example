# =================Anime Wiki — backend trên panel hosting =================
# Điền file này khi upload lên panel (hoặc điền tab Variables nếu panel hỗ trợ)
# Đánh dấu: BẮT BUỘC | optional

# --- BẮT BUỘC ---
# Supabase Project Settings → API
VITE_SUPABASE_URL=https://<PROJECT-REF>.supabase.co        # server cũng đọc biến này
VITE_SUPABASE_ANON_KEY=eyJ...                              # (chỉ frontend dùng thật sự)
SUPABASE_SERVICE_ROLE_KEY=eyJ...                           # ⚠️ SECRET — KHÔNG lộ (trả về đầy đủ quyền)
SITE_URL=https://animewiki.eu.cc

# --- optional: cache (bỏ trống -> tự dùng memory cache trong RAM) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- optional: dịch (chọn 1 trong 2) ---
DEEPL_API_KEY=
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=

# --- optional ---
ADMIN_PASSWORD_WEBHOOK=          # webhook discord nhận pass admin ngày
CRON_SECRET=                     # để trống — backend tự sinh và lưu DB

# PORT / SERVER_PORT: panel tự inject, không cần điền (code biết rồi)
